# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=oncology_intel
POSTGRES_USER=oncology
POSTGRES_PASSWORD=changeme

# ─── Neo4j ────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ─── Elasticsearch ────────────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Temporal ─────────────────────────────────────────────────
TEMPORAL_HOST=temporal:7233

# ─── Anthropic (Claude + Voyage embeddings) ───────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Free research APIs (no key required, but email helps) ────
NCBI_API_KEY=           # Optional: increases PubMed/ClinVar rate limit 10x
NCBI_EMAIL=             # Required by NCBI polite pool policy

# ─── Semantic Scholar ─────────────────────────────────────────
# Free: 100 req/5min. With key: 1 req/sec
# Get key: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# ─── CORE (open access full text) ─────────────────────────────
# Free: 100 req/day. With key: 10,000 req/day
# Get key: https://core.ac.uk/services/api
CORE_API_KEY=

# ─── OpenFDA ──────────────────────────────────────────────────
# Free: 240 req/min with key, 40/min without
# Get key: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# ─── Paid / credentialed APIs ─────────────────────────────────
# LinkedIn (official API or compliant data vendor)
LINKEDIN_API_KEY=

# X / Twitter API v2 (Basic tier required for search)
TWITTER_BEARER_TOKEN=

# Wiley TDM (institutional subscription required)
# https://onlinelibrary.wiley.com/library-info/resources/text-and-data-mining
WILEY_API_KEY=

# Apollo.io (HCP contact enrichment)
APOLLO_API_KEY=

# Voyage AI (vector embeddings, optional — falls back to Anthropic key)
VOYAGE_API_KEY=

# ─── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
